{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:v23c:qa": "node --test src/lib/personal-records-core.test.mjs && esbuild src/lib/v23c-qa.integration.test.mjs --bundle --platform=node --format=cjs --outfile=/tmp/v23c-qa.integration.cjs --external:pg-native && NODE_ENV=production node --test /tmp/v23c-qa.integration.cjs",
    "test:v24:accounts:qa": "esbuild src/lib/v24-accounts-qa.integration.test.mjs --bundle --platform=node --format=cjs --outfile=/tmp/v24-accounts-qa.integration.cjs --external:pg-native && NODE_ENV=production node --test /tmp/v24-accounts-qa.integration.cjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.75",
    "@clerk/shared": "^4.38.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
